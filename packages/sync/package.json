{
  "name": "bloom-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral Bloom sync + end-to-end encryption core (web build: web/bloom-sync.js)",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/browser.ts --bundle --minify --format=iife --target=es2019 --legal-comments=none --outfile=../../web/bloom-sync.js",
    "seal": "node scripts/seal-web.ts",
    "seal:check": "node scripts/seal-web.ts --check",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
